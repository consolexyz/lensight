# Network and Provider Configuration
ALCHEMY_API_KEY=  # Your Alchemy API key for network access
ETHERSCAN_API_KEY=  # Your Etherscan API key for contract verification

# Deployment Account
PRIVATE_KEY=  # Your deployment wallet's private key - REQUIRED

# Contract Configuration
PROTOCOL_FEE_PERCENTAGE=100  # In basis points (100 = 1%)
MIN_BET_AMOUNT=1000000  # Minimum bet amount in wei

# Resolver Configuration (for prediction resolution)
RESOLVER_PRIVATE_KEY=  # Private key for the resolver account
RESOLVER_ADDRESS=  # Address of the resolver account

# After deployment, copy the factory address to frontend/.env
# NEXT_PUBLIC_PREDICTION_FACTORY_ADDRESS=

# Gas and Testing Configuration
REPORT_GAS=true  # Enable gas reporting
FORK_BLOCK_NUMBER=  # Optional: Block number to fork from
COINMARKETCAP_API_KEY=  # Optional: For USD gas cost estimation
